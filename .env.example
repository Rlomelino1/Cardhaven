# Copy to .env and fill in. .env is gitignored — never commit it.
# `neon env pull` writes DATABASE_URL and DATABASE_URL_UNPOOLED for you.

# --- secrets -----------------------------------------------------------------
DATABASE_URL=              # pooled (-pooler host) — app runtime queries
DATABASE_URL_UNPOOLED=     # direct — ALL migrations, DDL, pg_dump
NEON_API_KEY=              # project-scoped, Editor access
OAUTH_CLIENT_SECRET=       # Google OAuth client secret

# --- not secrets -------------------------------------------------------------
# The two URLs below ship in the public index.html by design. Nothing behind them
# works without a valid JWT plus RLS. RLS is the security boundary, not obscurity.
NEON_AUTH_URL=
NEON_DATA_API_URL=
NEON_PROJECT_ID=
OAUTH_CLIENT_ID=           # Google OAuth client id — public half of the pair
